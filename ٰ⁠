869:                <div class="ayah-text">۞ وَإِذِ <span class="tj-slt">ٱ</span>سۡتَسۡقَ<span class="tj-mdd">ىٰ</span> مُوسَ<span class="tj-mdd">ىٰ</span> لِقَوۡمِهِۦ فَقُلۡنَا <span class="tj-slt">ٱ</span>ضۡرِب بِّعَصَاكَ <span class="tj-slt">ٱ</span>لۡحَجَرَۖ فَ<span class="tj-slt">ٱ</span><span class="tj-khf">ن</span>فَجَرَتۡ مِنۡهُ <span class="tj-slt">ٱ</span>ثۡنَتَا عَشۡرَةَ عَیۡنࣰاۖ قَ<span class="tj-qlq">دۡ</span> عَلِمَ كُلُّ أُنَا<span class="tj-dgm">سࣲ</span> <span class="tj-ghn">مَّ</span>شۡرَبَهُمۡۖ كُلُو<span class="tj-slt">ا۟</span> وَ<span class="tj-slt">ٱ</span>شۡرَبُو<span class="tj-slt">ا۟</span> مِ<span class="tj-dgm">ن</span> رِّزۡقِ <span class="tj-slt">ٱل</span>لَّهِ وَلَا تَعۡثَوۡ<span class="tj-slt">ا۟</span> فِی <span class="tj-slt">ٱ</span>لۡأَرۡضِ مُفۡسِدِینَ</div>
905:                <div class="ayah-text">وَإِذۡ قُلۡتُمۡ یَ<span class="tj-mdd">ـٰ</span>مُوسَ<span class="tj-mdd">ىٰ</span> لَ<span class="tj-dgm">ن</span> <span class="tj-ghn">نَّ</span>صۡبِرَ عَلَ<span class="tj-mdd">ىٰ</span> طَعَا<span class="tj-dgm">مࣲ</span> وَ<span class="tj-mdd"> ٰ⁠</span>حِ<span class="tj-khf">دࣲ</span> فَ<span class="tj-slt">ٱ</span><span class="tj-qlq">دۡ</span>عُ لَنَا رَبَّكَ یُخۡرِ<span class="tj-qlq">جۡ</span> لَنَا مِ<span class="tj-ghn">مَّ</span>ا تُ<span class="tj-qlb">نۢ</span>بِتُ <span class="tj-slt">ٱ</span>لۡأَرۡضُ مِ<span class="tj-qlb">نۢ</span> بَ<span class="tj-qlq">قۡ</span>لِهَا وَقِثَّ<span class="tj-mdd">اۤ</span>ىِٕهَا وَفُومِهَا وَعَدَسِهَا وَبَصَلِهَاۖ قَالَ أَتَسۡتَ<span class="tj-qlq">بۡ</span>دِلُونَ <span class="tj-slt">ٱلَّ</span>ذِی هُوَ أَ<span class="tj-qlq">دۡ</span>نَ<span class="tj-mdd">ىٰ</span> بِ<span class="tj-slt">ٱلَّ</span>ذِی هُوَ خَیۡرٌۚ <span class="tj-slt">ٱ</span>هۡبِطُو<span class="tj-slt">ا۟</span> مِصۡرࣰا فَإِ<span class="tj-ghn">نَّ</span> لَكُم <span class="tj-ghn">مَّ</span>ا سَأَلۡتُمۡۗ وَضُرِبَتۡ عَلَیۡهِمُ <span class="tj-slt">ٱل</span>ذِّلَّةُ وَ<span class="tj-slt">ٱ</span>لۡمَسۡكَنَةُ وَبَ<span class="tj-mdd">اۤ</span>ءُو بِغَضَ<span class="tj-dgm">بࣲ</span> <span class="tj-ghn">مِّ</span>نَ <span class="tj-slt">ٱل</span>لَّهِۗ ذَ<span class="tj-mdd"> ٰ⁠</span>لِكَ بِأَ<span class="tj-ghn">نَّ</span>هُمۡ كَانُو<span class="tj-slt">ا۟</span> یَكۡفُرُونَ بِـَٔایَ<span class="tj-mdd">ـٰ</span>تِ <span class="tj-slt">ٱل</span>لَّهِ وَیَ<span class="tj-qlq">قۡ</span>تُلُونَ <span class="tj-slt">ٱل</span><span class="tj-ghn">نَّ</span>بِیِّـۧنَ بِغَیۡرِ <span class="tj-slt">ٱ</span>لۡحَقِّۗ ذَ<span class="tj-mdd"> ٰ⁠</span>لِكَ بِمَا عَصَو<span class="tj-slt">ا۟</span> وَّكَانُو<span class="tj-slt">ا۟</span> یَعۡتَدُونَ</div>
941:                <div class="ayah-text">إِ<span class="tj-ghn">نَّ</span> <span class="tj-slt">ٱلَّ</span>ذِینَ ءَامَنُو<span class="tj-slt">ا۟</span> وَ<span class="tj-slt">ٱلَّ</span>ذِینَ هَادُو<span class="tj-slt">ا۟</span> وَ<span class="tj-slt">ٱل</span><span class="tj-ghn">نَّ</span>صَ<span class="tj-mdd">ـٰ</span>رَ<span class="tj-mdd">ىٰ</span> وَ<span class="tj-slt">ٱل</span>صَّ<span class="tj-mdd">ـٰ</span>بِـِٔینَ مَنۡ ءَامَنَ بِ<span class="tj-slt">ٱل</span>لَّهِ وَ<span class="tj-slt">ٱ</span>لۡیَوۡمِ <span class="tj-slt">ٱ</span>لۡـَٔاخِرِ وَعَمِلَ صَ<span class="tj-mdd">ـٰ</span>لِحࣰا فَلَهُمۡ أَ<span class="tj-qlq">جۡ</span>رُهُمۡ عِ<span class="tj-khf">ن</span>دَ رَبِّهِمۡ وَلَا خَوۡفٌ عَلَیۡهِمۡ وَلَا هُمۡ یَحۡزَنُونَ</div>
977:                <div class="ayah-text">وَإِذۡ أَخَذۡنَا مِیثَ<span class="tj-mdd">ـٰ</span>قَكُمۡ وَرَفَعۡنَا فَوۡقَكُمُ <span class="tj-slt">ٱل</span>طُّورَ خُذُو<span class="tj-slt">ا۟</span> مَ<span class="tj-mdd">اۤ</span> ءَاتَیۡنَ<span class="tj-mdd">ـٰ</span>كُم بِقُوَّ<span class="tj-dgm">ةࣲ</span> وَ<span class="tj-slt">ٱ</span>ذۡكُرُو<span class="tj-slt">ا۟</span> مَا فِیهِ لَعَلَّكُمۡ تَتَّقُونَ</div>
1013:                <div class="ayah-text">ثُ<span class="tj-ghn">مَّ</span> تَوَلَّیۡتُم <span class="tj-ghn">مِّ</span><span class="tj-qlb">نۢ</span> بَعۡدِ ذَ<span class="tj-mdd"> ٰ⁠</span>لِكَۖ فَلَوۡلَا فَضۡلُ <span class="tj-slt">ٱل</span>لَّهِ عَلَیۡكُمۡ وَرَحۡمَتُهُۥ لَكُ<span class="tj-khf">ن</span>تُم <span class="tj-ghn">مِّ</span>نَ <span class="tj-slt">ٱ</span>لۡخَ<span class="tj-mdd">ـٰ</span>سِرِینَ</div>
1049:                <div class="ayah-text">وَلَقَ<span class="tj-qlq">دۡ</span> عَلِمۡتُمُ <span class="tj-slt">ٱلَّ</span>ذِینَ <span class="tj-slt">ٱ</span>عۡتَدَوۡ<span class="tj-slt">ا۟</span> مِ<span class="tj-khf">ن</span>كُمۡ فِی <span class="tj-slt">ٱل</span>سَّ<span class="tj-qlq">بۡ</span>تِ فَقُلۡنَا لَهُمۡ كُونُو<span class="tj-slt">ا۟</span> قِرَدَةً خَ<span class="tj-mdd">ـٰ</span>سِـِٔینَ</div>
1085:                <div class="ayah-text">فَجَعَلۡنَ<span class="tj-mdd">ـٰ</span>هَا نَكَ<span class="tj-mdd">ـٰ</span>لࣰا لِّمَا بَیۡنَ یَدَیۡهَا وَمَا خَلۡفَهَا وَمَوۡعِظَ<span class="tj-dgm">ةࣰ</span> لِّلۡمُتَّقِینَ</div>
1121:                <div class="ayah-text">وَإِذۡ قَالَ مُوسَ<span class="tj-mdd">ىٰ</span> لِقَوۡمِهِ<span class="tj-mdd">ۦۤ</span> إِ<span class="tj-ghn">نَّ</span> <span class="tj-slt">ٱل</span>لَّهَ یَأۡمُرُكُمۡ أَ<span class="tj-khf">ن</span> تَذۡبَحُو<span class="tj-slt">ا۟</span> بَقَرَ<span class="tj-khf">ةࣰۖ</span> قَالُ<span class="tj-mdd">وۤ</span><span class="tj-slt">ا۟</span> أَتَتَّخِذُنَا هُزُوࣰاۖ قَالَ أَعُوذُ بِ<span class="tj-slt">ٱل</span>لَّهِ أَنۡ أَكُونَ مِنَ <span class="tj-slt">ٱ</span>لۡجَ<span class="tj-mdd">ـٰ</span>هِلِینَ</div>
1157:                <div class="ayah-text">قَالُو<span class="tj-slt">ا۟</span> <span class="tj-slt">ٱ</span><span class="tj-qlq">دۡ</span>عُ لَنَا رَبَّكَ یُبَیِّ<span class="tj-dgm">ن</span> لَّنَا مَا هِیَۚ قَالَ إِ<span class="tj-ghn">نَّ</span>هُۥ یَقُولُ إِ<span class="tj-ghn">نَّ</span>هَا بَقَرَ<span class="tj-dgm">ةࣱ</span> لَّا فَارِ<span class="tj-dgm">ضࣱ</span> وَلَا بِكۡرٌ عَوَانُۢ بَیۡنَ ذَ<span class="tj-mdd"> ٰ⁠</span>لِكَۖ فَ<span class="tj-slt">ٱ</span>فۡعَلُو<span class="tj-slt">ا۟</span> مَا تُؤۡمَرُونَ</div>
1193:                <div class="ayah-text">قَالُو<span class="tj-slt">ا۟</span> <span class="tj-slt">ٱ</span><span class="tj-qlq">دۡ</span>عُ لَنَا رَبَّكَ یُبَیِّ<span class="tj-dgm">ن</span> لَّنَا مَا لَوۡنُهَاۚ قَالَ إِ<span class="tj-ghn">نَّ</span>هُۥ یَقُولُ إِ<span class="tj-ghn">نَّ</span>هَا بَقَرَ<span class="tj-khf">ةࣱ</span> صَفۡرَ<span class="tj-mdd">اۤ</span>ءُ فَاقِ<span class="tj-dgm">عࣱ</span> لَّوۡنُهَا تَسُرُّ <span class="tj-slt">ٱل</span><span class="tj-ghn">نَّ</span><span class="tj-mdd">ـٰ</span>ظِرِینَ</div>
1229:                <div class="ayah-text">قَالُو<span class="tj-slt">ا۟</span> <span class="tj-slt">ٱ</span><span class="tj-qlq">دۡ</span>عُ لَنَا رَبَّكَ یُبَیِّ<span class="tj-dgm">ن</span> لَّنَا مَا هِیَ إِ<span class="tj-ghn">نَّ</span> <span class="tj-slt">ٱ</span>لۡبَقَرَ تَشَ<span class="tj-mdd">ـٰ</span>بَهَ عَلَیۡنَا وَإِ<span class="tj-ghn">نَّ</span><span class="tj-mdd">اۤ</span> إِ<span class="tj-khf">ن</span> شَ<span class="tj-mdd">اۤ</span>ءَ <span class="tj-slt">ٱل</span>لَّهُ لَمُهۡتَدُونَ</div>
1265:                <div class="ayah-text">قَالَ إِ<span class="tj-ghn">نَّ</span>هُۥ یَقُولُ إِ<span class="tj-ghn">نَّ</span>هَا بَقَرَ<span class="tj-dgm">ةࣱ</span> لَّا ذَلُو<span class="tj-khf">لࣱ</span> تُثِیرُ <span class="tj-slt">ٱ</span>لۡأَرۡضَ وَلَا تَسۡقِی <span class="tj-slt">ٱ</span>لۡحَرۡثَ مُسَلَّمَ<span class="tj-dgm">ةࣱ</span> لَّا شِیَةَ فِیهَاۚ قَالُو<span class="tj-slt">ا۟</span> <span class="tj-slt">ٱ</span>لۡـَٔ<span class="tj-mdd">ـٰ</span>نَ جِئۡتَ بِ<span class="tj-slt">ٱ</span>لۡحَقِّۚ فَذَبَحُوهَا وَمَا كَادُو<span class="tj-slt">ا۟</span> یَفۡعَلُونَ</div>
1301:                <div class="ayah-text">وَإِذۡ قَتَلۡتُمۡ نَفۡسࣰا فَ<span class="tj-slt">ٱ</span>دَّ<span class="tj-mdd"> ٰ⁠</span>رَ<span class="tj-mdd"> ٰٔۡ</span> ⁠تُمۡ فِیهَاۖ وَ<span class="tj-slt">ٱل</span>لَّهُ مُخۡرِ<span class="tj-dgm">جࣱ</span> <span class="tj-ghn">مَّ</span>ا كُ<span class="tj-khf">ن</span>تُمۡ تَكۡتُمُونَ</div>
1337:                <div class="ayah-text">فَقُلۡنَا <span class="tj-slt">ٱ</span>ضۡرِبُوهُ بِبَعۡضِهَاۚ كَذَ<span class="tj-mdd"> ٰ⁠</span>لِكَ یُحۡیِ <span class="tj-slt">ٱل</span>لَّهُ <span class="tj-slt">ٱ</span>لۡمَوۡتَ<span class="tj-mdd">ىٰ</span> وَیُرِیكُمۡ ءَایَ<span class="tj-mdd">ـٰ</span>تِهِۦ لَعَلَّكُمۡ تَعۡقِلُونَ</div>
1373:                <div class="ayah-text">ثُ<span class="tj-ghn">مَّ</span> قَسَتۡ قُلُوبُكُم <span class="tj-ghn">مِّ</span><span class="tj-qlb">نۢ</span> بَعۡدِ ذَ<span class="tj-mdd"> ٰ⁠</span>لِكَ فَهِیَ كَ<span class="tj-slt">ٱ</span>لۡحِجَارَةِ أَوۡ أَشَدُّ قَسۡوَ<span class="tj-dgm">ةࣰۚ</span> وَإِ<span class="tj-ghn">نَّ</span> مِنَ <span class="tj-slt">ٱ</span>لۡحِجَارَةِ لَمَا یَتَفَجَّرُ مِنۡهُ <span class="tj-slt">ٱ</span>لۡأَنۡهَ<span class="tj-mdd">ـٰ</span>رُۚ وَإِ<span class="tj-ghn">نَّ</span> مِنۡهَا لَمَا یَشَّقَّقُ فَیَخۡرُجُ مِنۡهُ <span class="tj-slt">ٱ</span>لۡمَ<span class="tj-mdd">اۤ</span>ءُۚ وَإِ<span class="tj-ghn">نَّ</span> مِنۡهَا لَمَا یَهۡبِطُ مِنۡ خَشۡیَةِ <span class="tj-slt">ٱل</span>لَّهِۗ وَمَا <span class="tj-slt">ٱل</span>لَّهُ بِغَ<span class="tj-mdd">ـٰ</span>فِلٍ عَ<span class="tj-ghn">مَّ</span>ا تَعۡمَلُونَ</div>
1409:                <div class="ayah-text">۞ أَفَتَ<span class="tj-qlq">طۡ</span>مَعُونَ أَن یُؤۡمِنُو<span class="tj-slt">ا۟</span> لَكُمۡ وَقَ<span class="tj-qlq">دۡ</span> كَانَ فَرِی<span class="tj-dgm">قࣱ</span> <span class="tj-ghn">مِّ</span>نۡهُمۡ یَسۡمَعُونَ كَلَ<span class="tj-mdd">ـٰ</span>مَ <span class="tj-slt">ٱل</span>لَّهِ ثُ<span class="tj-ghn">مَّ</span> یُحَرِّفُونَهُۥ مِ<span class="tj-qlb">نۢ</span> بَعۡدِ مَا عَقَلُوهُ وَهُمۡ یَعۡلَمُونَ</div>
1445:                <div class="ayah-text">وَإِذَا لَقُو<span class="tj-slt">ا۟</span> <span class="tj-slt">ٱلَّ</span>ذِینَ ءَامَنُو<span class="tj-slt">ا۟</span> قَالُ<span class="tj-mdd">وۤ</span><span class="tj-slt">ا۟</span> ءَامَ<span class="tj-ghn">نَّ</span>ا وَإِذَا خَلَا بَعۡضُهُمۡ إِلَ<span class="tj-mdd">ىٰ</span> بَعۡ<span class="tj-khf">ضࣲ</span> قَالُ<span class="tj-mdd">وۤ</span><span class="tj-slt">ا۟</span> أَتُحَدِّثُونَهُم بِمَا فَتَحَ <span class="tj-slt">ٱل</span>لَّهُ عَلَیۡكُمۡ لِیُحَ<span class="tj-mdd">اۤ</span>جُّوكُم بِهِۦ عِ<span class="tj-khf">ن</span>دَ رَبِّكُمۡۚ أَفَلَا تَعۡقِلُونَ</div>
1517:                <div class="ayah-text">وَمِنۡهُمۡ أُ<span class="tj-ghn">مِّ</span>یُّونَ لَا یَعۡلَمُونَ <span class="tj-slt">ٱ</span>لۡكِتَ<span class="tj-mdd">ـٰ</span>بَ إِلَّ<span class="tj-mdd">اۤ</span> أَمَانِیَّ وَإِنۡ هُمۡ إِلَّا یَظُ<span class="tj-ghn">نُّ</span>ونَ</div>
1553:                <div class="ayah-text">فَوَیۡ<span class="tj-dgm">لࣱ</span> لِّلَّذِینَ یَكۡتُبُونَ <span class="tj-slt">ٱ</span>لۡكِتَ<span class="tj-mdd">ـٰ</span>بَ بِأَیۡدِیهِمۡ ثُ<span class="tj-ghn">مَّ</span> یَقُولُونَ هَ<span class="tj-mdd">ـٰ</span>ذَا مِنۡ عِ<span class="tj-khf">ن</span>دِ <span class="tj-slt">ٱل</span>لَّهِ لِیَشۡتَرُو<span class="tj-slt">ا۟</span> بِهِۦ ثَمَنࣰا قَلِیلࣰاۖ فَوَیۡ<span class="tj-dgm">لࣱ</span> لَّهُم <span class="tj-ghn">مِّ</span><span class="tj-ghn">مَّ</span>ا كَتَبَتۡ أَیۡدِیهِمۡ وَوَیۡ<span class="tj-dgm">لࣱ</span> لَّهُم <span class="tj-ghn">مِّ</span><span class="tj-ghn">مَّ</span>ا یَكۡسِبُونَ</div>
1589:                <div class="ayah-text">وَقَالُو<span class="tj-slt">ا۟</span> لَ<span class="tj-khf">ن</span> تَمَسَّنَا <span class="tj-slt">ٱل</span><span class="tj-ghn">نَّ</span>ارُ إِلَّ<span class="tj-mdd">اۤ</span> أَیَّامࣰا <span class="tj-ghn">مَّ</span>عۡدُودَ<span class="tj-khf">ةࣰۚ</span> قُلۡ أَتَّخَذۡتُمۡ عِ<span class="tj-khf">ن</span>دَ <span class="tj-slt">ٱل</span>لَّهِ عَهۡدࣰا فَلَن یُخۡلِفَ <span class="tj-slt">ٱل</span>لَّهُ عَهۡدَهُ<span class="tj-mdd">ۥۤۖ</span> أَمۡ تَقُولُونَ عَلَى <span class="tj-slt">ٱل</span>لَّهِ مَا لَا تَعۡلَمُونَ</div>
1625:                <div class="ayah-text">بَلَ<span class="tj-mdd">ىٰۚ</span> مَ<span class="tj-khf">ن</span> كَسَبَ سَیِّئَ<span class="tj-dgm">ةࣰ</span> وَأَحَ<span class="tj-mdd">ـٰ</span>طَتۡ بِهِۦ خَطِ<span class="tj-mdd">یۤ</span>ـَٔتُهُۥ فَأُ<span class="tj-slt">و۟</span>لَ<span class="tj-mdd">ـٰۤ</span>ىِٕكَ أَصۡحَ<span class="tj-mdd">ـٰ</span>بُ <span class="tj-slt">ٱل</span><span class="tj-ghn">نَّ</span>ارِۖ هُمۡ فِیهَا خَ<span class="tj-mdd">ـٰ</span>لِدُونَ</div>
1661:                <div class="ayah-text">وَ<span class="tj-slt">ٱلَّ</span>ذِینَ ءَامَنُو<span class="tj-slt">ا۟</span> وَعَمِلُو<span class="tj-slt">ا۟</span> <span class="tj-slt">ٱل</span>صَّ<span class="tj-mdd">ـٰ</span>لِحَ<span class="tj-mdd">ـٰ</span>تِ أُ<span class="tj-slt">و۟</span>لَ<span class="tj-mdd">ـٰۤ</span>ىِٕكَ أَصۡحَ<span class="tj-mdd">ـٰ</span>بُ <span class="tj-slt">ٱ</span>لۡجَ<span class="tj-ghn">نَّ</span>ةِۖ هُمۡ فِیهَا خَ<span class="tj-mdd">ـٰ</span>لِدُونَ</div>
1697:                <div class="ayah-text">وَإِذۡ أَخَذۡنَا مِیثَ<span class="tj-mdd">ـٰ</span>قَ بَنِ<span class="tj-mdd">یۤ</span> إِسۡرَ<span class="tj-mdd"> ٰ⁠ۤ</span>ءِیلَ لَا تَعۡبُدُونَ إِلَّا <span class="tj-slt">ٱل</span>لَّهَ وَبِ<span class="tj-slt">ٱ</span>لۡوَ<span class="tj-mdd"> ٰ⁠</span>لِدَیۡنِ إِحۡسَانࣰا وَذِی <span class="tj-slt">ٱ</span>لۡقُرۡبَ<span class="tj-mdd">ىٰ</span> وَ<span class="tj-slt">ٱ</span>لۡیَتَ<span class="tj-mdd">ـٰ</span>مَ<span class="tj-mdd">ىٰ</span> وَ<span class="tj-slt">ٱ</span>لۡمَسَ<span class="tj-mdd">ـٰ</span>كِینِ وَقُولُو<span class="tj-slt">ا۟</span> لِل<span class="tj-ghn">نَّ</span>اسِ حُسۡنࣰا وَأَقِیمُو<span class="tj-slt">ا۟</span> <span class="tj-slt">ٱل</span>صَّلَ<span class="tj-mdd">وٰ</span>ةَ وَءَاتُو<span class="tj-slt">ا۟</span> <span class="tj-slt">ٱل</span>زَّكَ<span class="tj-mdd">وٰ</span>ةَ ثُ<span class="tj-ghn">مَّ</span> تَوَلَّیۡتُمۡ إِلَّا قَلِیلࣰا <span class="tj-ghn">مِّ</span><span class="tj-khf">ن</span>كُمۡ وَأَ<span class="tj-khf">ن</span>تُم <span class="tj-ghn">مُّ</span>عۡرِضُونَ</div>
1733:                <div class="ayah-text">وَإِذۡ أَخَذۡنَا مِیثَ<span class="tj-mdd">ـٰ</span>قَكُمۡ لَا تَسۡفِكُونَ دِمَ<span class="tj-mdd">اۤ</span>ءَكُمۡ وَلَا تُخۡرِجُونَ أَ<span class="tj-khf">ن</span>فُسَكُم <span class="tj-ghn">مِّ</span><span class="tj-khf">ن</span> دِیَ<span class="tj-mdd">ـٰ</span>رِكُمۡ ثُ<span class="tj-ghn">مَّ</span> أَ<span class="tj-qlq">قۡ</span>رَرۡتُمۡ وَأَ<span class="tj-khf">ن</span>تُمۡ تَشۡهَدُونَ</div>
1769:                <div class="ayah-text">ثُ<span class="tj-ghn">مَّ</span> أَ<span class="tj-khf">ن</span>تُمۡ هَ<span class="tj-mdd">ـٰۤ</span>ؤُلَ<span class="tj-mdd">اۤ</span>ءِ تَ<span class="tj-qlq">قۡ</span>تُلُونَ أَ<span class="tj-khf">ن</span>فُسَكُمۡ وَتُخۡرِجُونَ فَرِیقࣰا <span class="tj-ghn">مِّ</span><span class="tj-khf">ن</span>كُم <span class="tj-ghn">مِّ</span><span class="tj-khf">ن</span> دِیَ<span class="tj-mdd">ـٰ</span>رِهِمۡ تَظَ<span class="tj-mdd">ـٰ</span>هَرُونَ عَلَیۡهِم بِ<span class="tj-slt">ٱ</span>لۡإِثۡمِ وَ<span class="tj-slt">ٱ</span>لۡعُ<span class="tj-qlq">دۡ</span>وَ<span class="tj-mdd"> ٰ⁠</span>نِ وَإِن یَأۡتُوكُمۡ أُسَ<span class="tj-mdd">ـٰ</span>رَ<span class="tj-mdd">ىٰ</span> تُفَ<span class="tj-mdd">ـٰ</span>دُوهُمۡ وَهُوَ مُحَرَّمٌ عَلَیۡكُمۡ إِخۡرَاجُهُمۡۚ أَفَتُؤۡمِنُونَ بِبَعۡضِ <span class="tj-slt">ٱ</span>لۡكِتَ<span class="tj-mdd">ـٰ</span>بِ وَتَكۡفُرُونَ بِبَعۡ<span class="tj-khf">ضࣲۚ</span> فَمَا جَزَ<span class="tj-mdd">اۤ</span>ءُ مَن یَفۡعَلُ ذَ<span class="tj-mdd"> ٰ⁠</span>لِكَ مِ<span class="tj-khf">ن</span>كُمۡ إِلَّا خِزۡ<span class="tj-khf">یࣱ</span> فِی <span class="tj-slt">ٱ</span>لۡحَیَ<span class="tj-mdd">وٰ</span>ةِ <span class="tj-slt">ٱل</span>دُّنۡیَاۖ وَیَوۡمَ <span class="tj-slt">ٱ</span>لۡقِیَ<span class="tj-mdd">ـٰ</span>مَةِ یُرَدُّونَ إِلَ<span class="tj-mdd">ىٰۤ</span> أَشَدِّ <span class="tj-slt">ٱ</span>لۡعَذَابِۗ وَمَا <span class="tj-slt">ٱل</span>لَّهُ بِغَ<span class="tj-mdd">ـٰ</span>فِلٍ عَ<span class="tj-ghn">مَّ</span>ا تَعۡمَلُونَ</div>
1805:                <div class="ayah-text">أُ<span class="tj-slt">و۟</span>لَ<span class="tj-mdd">ـٰۤ</span>ىِٕكَ <span class="tj-slt">ٱلَّ</span>ذِینَ <span class="tj-slt">ٱ</span>شۡتَرَوُ<span class="tj-slt">ا۟</span> <span class="tj-slt">ٱ</span>لۡحَیَ<span class="tj-mdd">وٰ</span>ةَ <span class="tj-slt">ٱل</span>دُّنۡیَا بِ<span class="tj-slt">ٱ</span>لۡـَٔاخِرَةِۖ فَلَا یُخَفَّفُ عَنۡهُمُ <span class="tj-slt">ٱ</span>لۡعَذَابُ وَلَا هُمۡ یُ<span class="tj-khf">ن</span>صَرُونَ</div>
